# ==============================================================================
# Terraform
# ==============================================================================

# Provider-binærer og modulcache. Stor (hundrevis av MB) og reproduserbar.
**/.terraform/*

# Lokal state. Repoet kjører uten backend, så disse vil inneholde
# subscription-IDer, gruppe-object-IDer, UPN-er og PIM-policy i klartekst.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Plan-filer. Inneholder samme sensitive verdier som state.
*.tfplan
*.tfplan.*
plan.out

# Crash-logger fra Terraform og providere.
crash.log
crash.*.log

# ------------------------------------------------------------------------------
# Variabelfiler
#
# terraform.tfvars holds real subscription IDs, systemeier UPNs,
# eligible_user_principal_names and approver group names. It must never be
# committed in THIS repo. The .example file with placeholders does belong in git.
#
# Note the asymmetry: a CONSUMER repo should commit its terraform.tfvars, because
# there the access configuration is the governance record and belongs in reviewed
# pull requests. See examples/github-consumption/README.md. This repo is the
# module source and holds named individuals' UPNs, so it does not.
# ------------------------------------------------------------------------------
*.tfvars
*.tfvars.json
!*.tfvars.example

# Test fixtures are input, not secrets — all-zero placeholder GUIDs, and no
# provider ever authenticates with them. They MUST be committed or the
# regression tests silently pass against no input in CI.
!tests/**/terraform.tfvars

# Backend configuration. Not secret, but environment-specific — a committed
# backend.hcl makes the next person run against the wrong state without noticing.
backend.hcl

# CLI config that may contain credentials or mirror setup.
.terraformrc
terraform.rc

# ------------------------------------------------------------------------------
# Lock-filer
#
# Rot-modulens .terraform.lock.hcl SKAL committes — den pinner provider-
# versjoner. Undermoduler pinner ikke, så deres lock-filer holdes ute.
# ------------------------------------------------------------------------------
modules/**/.terraform.lock.hcl
examples/**/.terraform.lock.hcl
bootstrap/.terraform.lock.hcl

# ==============================================================================
# Credentials og miljø
# ==============================================================================

.env
.env.*
*.pem
*.key
azure-credentials.json
sp-credentials.json

# ==============================================================================
# Verktøy og OS
# ==============================================================================

# Mellomfiler fra diagram-generering. PNG committes bevisst.
generated-diagrams/*.dot
generated-diagrams/*.drawio

.DS_Store
.vscode/
.idea/
*.swp
*~

# ==============================================================================
# Referansemateriale
# ==============================================================================

# Precursor-modulen er referanse, ikke en del av dette repoet. 225 MB, hvorav
# 224 MB er en provider-binær og et nøstet .git under bootstrap/.terraform/.
precursor-module/
